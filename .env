# Airflow 3.1.0 Docker Compose Environment Configuration

# Core Configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Redis Configuration (for CeleryExecutor)
REDIS_PASSWORD=airflow

# Airflow Fernet Key (generate new one for production)
# Generated using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# For development purposes - CHANGE THIS IN PRODUCTION
AIRFLOW_FERNET_KEY=d6s8K9Zx2mN4pQ7tR1uY5wE8rT2yU6iO9pA3sD6fG9hJ2kL5nM8qR1tY4wE7rT0y

# API Secret Key for Airflow 3.1.0 (replaces webserver secret key)
# Generated using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For development purposes - CHANGE THIS IN PRODUCTION
# This key is used for both API authentication and JWT token signing
AIRFLOW_SECRET_KEY=dev-api-secret-key-change-in-production-67890

# Executor Configuration
# Options: LocalExecutor, CeleryExecutor
AIRFLOW_EXECUTOR=LocalExecutor

# Authentication Configuration
# Uses SimpleAuthManager (default in Airflow 3.1.0)
AIRFLOW_AUTH_MANAGER=SimpleAuthManager

# Admin User Configuration
# These credentials will be used to create/update the admin user in Airflow
# The password will persist across container restarts, eliminating the need
# to retrieve new passwords after each docker compose down/up cycle
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin123



# Development Settings
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_DAGS_ARE_PAUSED_AT_CREATION=true

# Web UI Configuration
AIRFLOW_WEBSERVER_PORT=8080

# Flower Configuration (CeleryExecutor monitoring)
FLOWER_PORT=5555

# Hostname Configuration (prevents Docker Compose warnings)
HOSTNAME=airflow-host