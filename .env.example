# Airflow 3.1.0 Docker Compose Environment Configuration Template
# Copy this file to .env and customize the values

# Core Configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Database Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Redis Configuration (for CeleryExecutor)
REDIS_PASSWORD=airflow

# Airflow Fernet Key (REQUIRED - generate new one)
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_THIS_TO_A_REAL_FERNET_KEY

# JWT Secret Key for Simple Auth Manager (REQUIRED - generate new one)
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET_KEY=CHANGE_THIS_TO_A_REAL_JWT_SECRET_KEY

# Webserver Secret Key (REQUIRED - generate new one)
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=CHANGE_THIS_TO_A_REAL_SECRET_KEY

# Executor Configuration
# Options: 
#   - LocalExecutor: Single-node execution (good for development)
#   - CeleryExecutor: Distributed execution with workers (production)
# NOTE: If using CeleryExecutor, also set COMPOSE_PROFILES=celery,flower
AIRFLOW_EXECUTOR=LocalExecutor

# Authentication Configuration
# Uses SimpleAuthManager (default in Airflow 3.1.0)
AIRFLOW_AUTH_MANAGER=SimpleAuthManager

# Development Settings
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_DAGS_ARE_PAUSED_AT_CREATION=true

# Web UI Configuration
AIRFLOW_WEBSERVER_PORT=8080

# Flower Configuration (CeleryExecutor monitoring)
FLOWER_PORT=5555

# Worker Configuration (CeleryExecutor only)
# Number of Celery worker replicas to run
NUMBER_OF_WORKERS=2

# Docker Compose Profiles Configuration
# Controls which services are started by default
# Options:
#   - "" (empty): LocalExecutor only (core services)
#   - "celery": Adds CeleryExecutor services (Redis, workers)
#   - "flower": Adds Flower monitoring dashboard
#   - "celery,flower": Full CeleryExecutor setup with monitoring
COMPOSE_PROFILES=

# Hostname Configuration (prevents Docker Compose warnings)
HOSTNAME=airflow-host

# Windows 11 Specific Settings
# Ensure Docker Desktop is configured with at least 4GB RAM
# Use WSL2 backend for better performance